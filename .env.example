# ---- Database (MySQL 8) ----
DATABASE_URL=mysql://user:password@host:3306/cityink

# ---- AI ----
# anthropic  |  openai  (openai also covers Groq / OpenRouter / anything compatible)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=            # only if using a compatible third-party endpoint

# ---- Symphony ----
# Brad's own business agents. Used as the second channel for booking alerts
# when Facebook won't deliver one, and by the Send box in Settings.
# Issued in Symphony -> Settings -> Connections. Treat it like a password:
# anyone holding it can act as you.
SYMPHONY_API_TOKEN=
# SYMPHONY_BASE_URL=       # only if the agent API moves
# SYMPHONY_SESSION_ID=     # the thread replies stay in; defaults to city-ink-agent

# ---- Server ----
PORT=3000
NODE_ENV=development

# Fallback verify token, used only before Facebook is connected in Settings
VERIFY_TOKEN=city_ink_webhook_2024

# How long the agent stays quiet after a person replies from Page Inbox
HANDOFF_PAUSE_HOURS=12
